{
  "name": "saytwist-platform",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node node_modules/prisma/build/index.js generate",
    "build": "next build",
    "start": "node server.js",
    "start:hostinger": "node server.js",
    "start:editorial-worker": "tsx workers/editorial-worker.ts",
    "growth:worker": "tsx workers/growth-worker.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test": "vitest run",
    "test:growth-db": "test -n \"$GROWTH_TEST_DATABASE_URL\" && DATABASE_URL=\"$GROWTH_TEST_DATABASE_URL\" RUN_GROWTH_DB_TESTS=1 vitest run tests/growth-persistence.integration.test.ts",
    "test:growth-pinterest-db": "test -n \"$GROWTH_PINTEREST_TEST_DATABASE_URL\" && DATABASE_URL=\"$GROWTH_PINTEREST_TEST_DATABASE_URL\" RUN_GROWTH_PINTEREST_DB_TESTS=1 vitest run tests/pinterest-persistence.integration.test.ts",
    "test:growth-analytics-db": "test -n \"$GROWTH_ANALYTICS_TEST_DATABASE_URL\" && DATABASE_URL=\"$GROWTH_ANALYTICS_TEST_DATABASE_URL\" RUN_GROWTH_ANALYTICS_DB_TESTS=1 vitest run tests/pinterest-analytics-persistence.integration.test.ts",
    "test:growth-relevance-db": "test -n \"$GROWTH_RELEVANCE_TEST_DATABASE_URL\" && DATABASE_URL=\"$GROWTH_RELEVANCE_TEST_DATABASE_URL\" RUN_GROWTH_RELEVANCE_DB_TESTS=1 vitest run tests/pinterest-relevance-persistence.integration.test.ts",
    "test:growth-attribution-db": "test -n \"$GROWTH_ATTRIBUTION_TEST_DATABASE_URL\" && DATABASE_URL=\"$GROWTH_ATTRIBUTION_TEST_DATABASE_URL\" GROWTH_ATTRIBUTION_COLLECTION_ENABLED=true RUN_GROWTH_ATTRIBUTION_DB_TESTS=1 vitest run tests/growth-attribution-persistence.integration.test.ts",
    "test:growth-strategy-db": "test -n \"$GROWTH_STRATEGY_TEST_DATABASE_URL\" && DATABASE_URL=\"$GROWTH_STRATEGY_TEST_DATABASE_URL\" GROWTH_ATTRIBUTION_COLLECTION_ENABLED=false RUN_GROWTH_STRATEGY_DB_TESTS=1 vitest run tests/growth-strategy-persistence.integration.test.ts",
    "test:growth-opportunity-db": "test -n \"$GROWTH_OPPORTUNITY_TEST_DATABASE_URL\" && DATABASE_URL=\"$GROWTH_OPPORTUNITY_TEST_DATABASE_URL\" GROWTH_ATTRIBUTION_COLLECTION_ENABLED=false RUN_GROWTH_OPPORTUNITY_DB_TESTS=1 vitest run tests/growth-opportunity-persistence.integration.test.ts",
    "test:growth-translator-db": "test -n \"$GROWTH_TRANSLATOR_TEST_DATABASE_URL\" && DATABASE_URL=\"$GROWTH_TRANSLATOR_TEST_DATABASE_URL\" GROWTH_ATTRIBUTION_COLLECTION_ENABLED=false RUN_GROWTH_TRANSLATOR_DB_TESTS=1 vitest run tests/growth-translator-persistence.integration.test.ts",
    "test:growth-ideas-db": "test -n \"$GROWTH_IDEAS_TEST_DATABASE_URL\" && DATABASE_URL=\"$GROWTH_IDEAS_TEST_DATABASE_URL\" GROWTH_ATTRIBUTION_COLLECTION_ENABLED=false RUN_GROWTH_IDEAS_DB_TESTS=1 vitest run tests/growth-ideas-persistence.integration.test.ts",
    "test:growth-creative-db": "test -n \"$GROWTH_CREATIVE_TEST_DATABASE_URL\" && DATABASE_URL=\"$GROWTH_CREATIVE_TEST_DATABASE_URL\" GROWTH_ATTRIBUTION_COLLECTION_ENABLED=false RUN_GROWTH_CREATIVE_DB_TESTS=1 vitest run tests/growth-creative-persistence.integration.test.ts",
    "test:watch": "vitest",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "prisma:status": "node node_modules/prisma/build/index.js migrate status",
    "prisma:seed": "node node_modules/prisma/build/index.js db seed",
    "prisma:studio": "node node_modules/prisma/build/index.js studio",
    "validate:env:production": "tsx scripts/validate-production-env.ts",
    "prepare:production": "npm run validate:env:production && npm run prisma:generate && npm run prisma:deploy && npm run build",
    "deploy:hostinger": "sh ./scripts/hostinger-deploy.sh",
    "featured:recalculate": "tsx scripts/recalculate-featured-translators.ts",
    "test:growth-publishing-db": "sh scripts/test-growth-publishing-db.sh"
  },
  "postinstall": "node node_modules/prisma/build/index.js generate",
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next": "^16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^6.34.0",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.25",
    "deepmerge-ts": "8.0.2"
  }
}
