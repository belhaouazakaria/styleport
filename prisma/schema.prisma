generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  USER
}

enum TranslationStatus {
  SUCCESS
  FAILURE
  BLOCKED
}

enum AdPageType {
  ALL
  HOMEPAGE
  TRANSLATOR
  CATEGORY
}

enum AdDeviceType {
  ALL
  DESKTOP
  MOBILE
}

enum AdPlacementType {
  HOMEPAGE_TOP
  HOMEPAGE_BETWEEN_SECTIONS
  TRANSLATOR_ABOVE_TOOL
  TRANSLATOR_BELOW_TOOL
  SIDEBAR_SLOT
  FOOTER_SLOT
  MOBILE_STICKY_SLOT
  CUSTOM
}

enum AdProviderType {
  ADSENSE
  CUSTOM_HTML
}

enum TranslatorRequestStatus {
  PENDING_EMAIL_VERIFICATION
  VERIFIED
  PENDING_REVIEW
  NEW
  REVIEWING
  DRAFT_GENERATED
  APPROVED
  REJECTED
  COMPLETED
  PUBLISHED
}

enum CommentModerationStatus {
  VISIBLE
  PENDING_REVIEW
  HIDDEN
  REJECTED
}

enum FeaturedSource {
  MANUAL
  AUTO
}

enum UsageProtectionEventType {
  EMERGENCY_SHUTDOWN
  MANUAL_REENABLE
}

enum IndexingProvider {
  GOOGLE_INDEXING_API
}

enum IndexingSource {
  MANUAL_SINGLE
  MANUAL_BULK
  AUTO_ACTIVE
}

enum EditorialListKind {
  BEST_USE
  HOW_TO_USE
  TIP
}

enum IndexingStatus {
  PENDING
  SUBMITTED
  FAILED
  SKIPPED
  DRY_RUN
}

enum TranslatorEditorialJobType {
  GENERATE_MISSING
  REGENERATE_FULL
  REGENERATE_ABOUT
  REGENERATE_WHAT_IT_DOES
  REGENERATE_DIFFERENCE
  REGENERATE_BEST_USES
  REGENERATE_HOW_TO_USE
  REGENERATE_EXAMPLES
  REGENERATE_FAQ
  REGENERATE_TIPS
}

enum TranslatorEditorialJobStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum TranslatorEditorialJobItemStatus {
  PENDING
  PROCESSING
  GENERATED
  FAILED
  SKIPPED
  CANCELLED
}

enum TranslatorEditorialDraftStatus {
  NEEDS_REVIEW
  APPROVED
  DISCARDED
  PUBLISHED
}

