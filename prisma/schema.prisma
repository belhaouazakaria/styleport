generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  USER
}

enum TranslationStatus {
  SUCCESS
  FAILURE
  BLOCKED
}

enum AdPageType {
  ALL
  HOMEPAGE
  TRANSLATOR
  CATEGORY
}

enum AdDeviceType {
  ALL
  DESKTOP
  MOBILE
}

enum AdPlacementType {
  HOMEPAGE_TOP
  HOMEPAGE_BETWEEN_SECTIONS
  TRANSLATOR_ABOVE_TOOL
  TRANSLATOR_BELOW_TOOL
  SIDEBAR_SLOT
  FOOTER_SLOT
  MOBILE_STICKY_SLOT
  CUSTOM
}

enum AdProviderType {
  ADSENSE
  CUSTOM_HTML
}

enum TranslatorRequestStatus {
  PENDING_EMAIL_VERIFICATION
  VERIFIED
  PENDING_REVIEW
  NEW
  REVIEWING
  DRAFT_GENERATED
  APPROVED
  REJECTED
  COMPLETED
  PUBLISHED
}

enum CommentModerationStatus {
  VISIBLE
  PENDING_REVIEW
  HIDDEN
  REJECTED
}

enum FeaturedSource {
  MANUAL
  AUTO
}

enum UsageProtectionEventType {
  EMERGENCY_SHUTDOWN
  MANUAL_REENABLE
}

enum IndexingProvider {
  GOOGLE_INDEXING_API
}

enum IndexingSource {
  MANUAL_SINGLE
  MANUAL_BULK
  AUTO_ACTIVE
}

enum EditorialListKind {
  BEST_USE
  HOW_TO_USE
  TIP
}

enum IndexingStatus {
  PENDING
  SUBMITTED
  FAILED
  SKIPPED
  DRY_RUN
}

enum TranslatorEditorialJobType {
  GENERATE_MISSING
  REGENERATE_FULL
  REGENERATE_ABOUT
  REGENERATE_WHAT_IT_DOES
  REGENERATE_DIFFERENCE
  REGENERATE_BEST_USES
  REGENERATE_HOW_TO_USE
  REGENERATE_EXAMPLES
  REGENERATE_FAQ
  REGENERATE_TIPS
}

enum TranslatorEditorialJobStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum TranslatorEditorialJobItemStatus {
  PENDING
  PROCESSING
  GENERATED
  FAILED
  SKIPPED
  CANCELLED
}

enum TranslatorEditorialDraftStatus {
  NEEDS_REVIEW
  APPROVED
  DISCARDED
  PUBLISHED
}

enum GrowthIntensity {
  LOW
  BALANCED
  AGGRESSIVE
  CUSTOM
}

enum GrowthJobType {
  FOUNDATION_NOOP
  PINTEREST_ACCOUNT_SYNC
  PINTEREST_BOARD_SYNC
  PINTEREST_PIN_INVENTORY_SYNC
  PINTEREST_ACCOUNT_ANALYTICS_SYNC
  PINTEREST_PIN_ANALYTICS_SYNC
  ATTRIBUTION_RETENTION_CLEANUP
  ACCOUNT_STRATEGY_REVIEW
  OPPORTUNITY_INTELLIGENCE_ANALYSIS
}

enum GrowthJobStatus {
  PENDING
  CLAIMED
  RUNNING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_TERMINAL
  CANCELLED
}

enum GrowthActivityActorKind {
  SYSTEM
  USER
  WORKER
}

enum GrowthWorkerStatus {
  RUNNING
  IDLE
  FAILED
}

enum GrowthPinterestPublicationRole {
  SAYTWIST
  SAYTWIST_IDEAS
  SAYTWIST_PLAYGROUND
}

enum GrowthPinterestConnectionStatus {
  CONNECTED
  DEGRADED
  REAUTH_REQUIRED
  DISCONNECTED
}

enum GrowthPinterestApiEnvironment {
  SANDBOX
  PRODUCTION
}

enum GrowthPinterestAnalyticsStatus {
  NEVER_SYNCED
  BACKFILLING
  FRESH
  STALE
  PARTIAL
  FAILED
}

enum GrowthAttributionEventType {
  PINTEREST_LANDING
  TRANSLATOR_VIEW
  INPUT_STARTED
  TRANSLATION_COMPLETED
  IDEA_VIEW
  IDEA_CTA
  EMBEDDED_TRANSLATION_COMPLETED
}

enum GrowthAccountStrategyRecommendation {
  KEEP_CURRENT_PORTFOLIO
  COMPLETE_BASELINE_PORTFOLIO
  REPOSITION_EXISTING_ROLE
  RECOMMEND_NEW_ACCOUNT
  WAIT_FOR_MORE_DATA
}

enum GrowthStrategyEvidenceQuality {
  KNOWN
  UNKNOWN
  INSUFFICIENT_DATA
  NOT_APPLICABLE
}

enum GrowthOpportunityType {
  AMPLIFY_WINNER
  EXPLORE_RISING_TOPIC
  FILL_INVENTORY_GAP
  INVESTIGATE_FATIGUE
  HIGH_CONVERSION_LOW_REACH
  HIGH_CLICK_LOW_CONVERSION
}

enum GrowthOpportunityStatus {
  OPEN
  EVALUATING
  ACTIONED
  DEFERRED
  DISMISSED
  CANCELLED
  FAILED_RETRYABLE
  FAILED_TERMINAL
}

enum GrowthOpportunityEvidenceQuality {
  KNOWN
  PARTIAL
  INSUFFICIENT_DATA
  STALE
  NOT_APPLICABLE
}

enum GrowthContentClusterStatus {
  ACTIVE
  INSUFFICIENT_DATA
  ARCHIVED
}

enum GrowthOpportunityDestinationKind {
  TRANSLATOR
  FUTURE_IDEAS
  MULTIPLE
  UNKNOWN
}

enum GrowthPinSignalType {
  WINNER
  RISING
  FATIGUE
}

enum GrowthSignalStrength {
  STRONG
  CAUTIOUS
}

model User {
  id                    String                      @id @default(cuid())
  name                  String?
  email                 String                      @unique
  emailVerified         DateTime?
  image                 String?
  passwordHash          String
  role                  Role                        @default(USER)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  accounts              Account[]
  sessions              Session[]
  editorialJobs         TranslatorEditorialJob[]    @relation("TranslatorEditorialJobRequester")
  editorialDraftReviews TranslatorEditorialDraft[]  @relation("TranslatorEditorialDraftReviewer")
  growthSettingsUpdates GrowthSettings[]            @relation("GrowthSettingsUpdater")
  growthActivities      GrowthActivity[]            @relation("GrowthActivityUser")
  growthPinterestStates GrowthPinterestOAuthState[] @relation("GrowthPinterestOAuthStateAdmin")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Translator {
  id                           String                            @id @default(cuid())
  name                         String
  slug                         String                            @unique
  title                        String
  subtitle                     String
  shortDescription             String
  sourceLabel                  String
  targetLabel                  String
  category                     String?
  iconName                     String?
  promptSystem                 String
  promptInstructions           String
  modelOverride                String?
  seoTitle                     String?
  seoDescription               String?
  showModeSelector             Boolean                           @default(false)
  showSwap                     Boolean                           @default(false)
  showExamples                 Boolean                           @default(false)
  isActive                     Boolean                           @default(true)
  isFeatured                   Boolean                           @default(false)
  featuredRank                 Int?
  featuredSource               FeaturedSource                    @default(MANUAL)
  shareImagePath               String?
  shareImageHash               String?
  shareImageUpdatedAt          DateTime?
  sortOrder                    Int                               @default(0)
  archivedAt                   DateTime?
  primaryCategoryId            String?
  createdAt                    DateTime                          @default(now())
  updatedAt                    DateTime                          @updatedAt
  modes                        TranslationMode[]
  examples                     TranslatorExample[]
  logs                         TranslationLog[]
  categories                   TranslatorCategory[]
  primaryCategory              Category?                         @relation("PrimaryTranslatorCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  fulfilledRequests            TranslatorRequest[]               @relation("RequestCreatedTranslator")
  comments                     TranslatorComment[]
  indexingLogs                 IndexingLog[]
  editorialContent             TranslatorEditorialContent?
  editorialLists               TranslatorEditorialList[]
  editorialExamples            TranslatorEditorialExample[]
  editorialFaqs                TranslatorEditorialFaq[]
  editorialJobItems            TranslatorEditorialJobItem[]
  editorialDrafts              TranslatorEditorialDraft[]
  growthAttributionSessions    GrowthAttributionSession[]        @relation("GrowthAttributionQualifiedTranslator")
  growthAttributionEvents      GrowthAttributionEvent[]
  growthOpportunityMemberships GrowthContentClusterMembership[]
  growthAttributionAggregates  GrowthAttributionDailyAggregate[]

  @@index([isActive, isFeatured, sortOrder])
  @@index([isFeatured, featuredRank])
  @@index([updatedAt])
  @@index([primaryCategoryId])
}

model TranslatorEditorialJob {
  id             String                       @id @default(cuid())
  type           TranslatorEditorialJobType
  status         TranslatorEditorialJobStatus @default(PENDING)
  requestedById  String?
  configuration  Json?
  totalItems     Int                          @default(0)
  succeededItems Int                          @default(0)
  failedItems    Int                          @default(0)
  skippedItems   Int                          @default(0)
  createdAt      DateTime                     @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  updatedAt      DateTime                     @updatedAt
  requestedBy    User?                        @relation("TranslatorEditorialJobRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  items          TranslatorEditorialJobItem[]

  @@index([status, createdAt])
  @@index([requestedById, createdAt])
}

model TranslatorEditorialJobItem {
  id           String                           @id @default(cuid())
  jobId        String
  translatorId String
  operation    TranslatorEditorialJobType
  status       TranslatorEditorialJobItemStatus @default(PENDING)
  attemptCount Int                              @default(0)
  lastError    String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime                         @default(now())
  updatedAt    DateTime                         @updatedAt
  job          TranslatorEditorialJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  translator   Translator                       @relation(fields: [translatorId], references: [id], onDelete: Cascade)
  draft        TranslatorEditorialDraft?

  @@unique([jobId, translatorId])
  @@index([status, createdAt])
  @@index([translatorId, status])
}

model TranslatorEditorialDraft {
  id           String                         @id @default(cuid())
  jobItemId    String                         @unique
  translatorId String
  status       TranslatorEditorialDraftStatus @default(NEEDS_REVIEW)
  payload      Json
  validation   Json
  generatedAt  DateTime                       @default(now())
  reviewedById String?
  reviewedAt   DateTime?
  publishedAt  DateTime?
  discardedAt  DateTime?
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt
  jobItem      TranslatorEditorialJobItem     @relation(fields: [jobItemId], references: [id], onDelete: Cascade)
  translator   Translator                     @relation(fields: [translatorId], references: [id], onDelete: Cascade)
  reviewedBy   User?                          @relation("TranslatorEditorialDraftReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([translatorId, status])
}

model TranslatorEditorialContent {
  id                    String     @id @default(cuid())
  translatorId          String     @unique
  about                 String?
  whatItDoes            String?
  differenceDescription String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  translator            Translator @relation(fields: [translatorId], references: [id], onDelete: Cascade)
}

model TranslatorEditorialList {
  id           String            @id @default(cuid())
  translatorId String
  kind         EditorialListKind
  content      String
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  translator   Translator        @relation(fields: [translatorId], references: [id], onDelete: Cascade)

  @@index([translatorId, kind, sortOrder])
}

model TranslatorEditorialExample {
  id              String     @id @default(cuid())
  translatorId    String
  contextTitle    String?
  originalText    String
  transformedText String
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  translator      Translator @relation(fields: [translatorId], references: [id], onDelete: Cascade)

  @@index([translatorId, sortOrder])
}

model TranslatorEditorialFaq {
  id           String     @id @default(cuid())
  translatorId String
  question     String
  answer       String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  translator   Translator @relation(fields: [translatorId], references: [id], onDelete: Cascade)

  @@index([translatorId, sortOrder])
}

model Category {
  id             String               @id @default(cuid())
  name           String
  slug           String               @unique
  description    String?
  sortOrder      Int                  @default(0)
  isActive       Boolean              @default(true)
  iconKey        String?
  seoTitle       String?
  seoDescription String?
  archivedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  translators    TranslatorCategory[]
  primaryFor     Translator[]         @relation("PrimaryTranslatorCategory")
  adPlacements   AdPlacement[]

  @@index([isActive, sortOrder])
}

model TranslatorCategory {
  id           String     @id @default(cuid())
  translatorId String
  categoryId   String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  translator   Translator @relation(fields: [translatorId], references: [id], onDelete: Cascade)
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([translatorId, categoryId])
  @@index([translatorId, sortOrder])
  @@index([categoryId, sortOrder])
}

model TranslationMode {
  id           String     @id @default(cuid())
  translatorId String
  key          String
  label        String
  description  String?
  instruction  String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  translator   Translator @relation(fields: [translatorId], references: [id], onDelete: Cascade)

  @@unique([translatorId, key])
  @@index([translatorId, sortOrder])
}

model TranslatorExample {
  id           String     @id @default(cuid())
  translatorId String
  label        String
  value        String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  translator   Translator @relation(fields: [translatorId], references: [id], onDelete: Cascade)

  @@index([translatorId, sortOrder])
}

model TranslationLog {
  id                                String                    @id @default(cuid())
  translatorId                      String
  inputText                         String
  outputText                        String?
  modeUsed                          String?
  status                            TranslationStatus         @default(SUCCESS)
  inputLength                       Int                       @default(0)
  outputLength                      Int                       @default(0)
  model                             String?
  promptTokens                      Int?
  completionTokens                  Int?
  totalTokens                       Int?
  estimatedCost                     Decimal?                  @db.Decimal(12, 6)
  errorCode                         String?
  latencyMs                         Int?
  ipHash                            String?
  userAgent                         String?
  createdAt                         DateTime                  @default(now())
  translator                        Translator                @relation(fields: [translatorId], references: [id], onDelete: Cascade)
  growthAttributionEvent            GrowthAttributionEvent?
  qualifiedGrowthAttributionSession GrowthAttributionSession? @relation("GrowthAttributionQualifiedTranslation")

  @@index([translatorId, createdAt])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([ipHash, createdAt])
  @@index([errorCode, createdAt])
}

model UsageProtectionState {
  id                           String                 @id @default("global")
  usageProtectionEnabled       Boolean                @default(true)
  ipLimitPerMinute             Int                    @default(5)
  ipLimitPerHour               Int                    @default(50)
  ipLimitPerDay                Int                    @default(200)
  globalDailyTokenCap          Int                    @default(200000)
  autoEmergencyShutdownEnabled Boolean                @default(true)
  translationsEnabled          Boolean                @default(true)
  shutdownReason               String?
  shutdownTriggeredAt          DateTime?
  alertEmail                   String?
  lastShutdownEventId          String?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  events                       UsageProtectionEvent[] @relation("UsageProtectionStateEvents")
  lastShutdownEvent            UsageProtectionEvent?  @relation("LastShutdownEvent", fields: [lastShutdownEventId], references: [id], onDelete: SetNull)
}

model UsageProtectionEvent {
  id                  String                   @id @default(cuid())
  stateId             String
  type                UsageProtectionEventType
  reason              String
  tokenUsageAtTrigger Int?
  tokenCapAtTrigger   Int?
  alertEmail          String?
  alertSentAt         DateTime?
  alertError          String?
  createdBy           String?
  createdAt           DateTime                 @default(now())
  state               UsageProtectionState     @relation("UsageProtectionStateEvents", fields: [stateId], references: [id], onDelete: Cascade)
  lastForStates       UsageProtectionState[]   @relation("LastShutdownEvent")

  @@index([stateId, createdAt])
  @@index([type, createdAt])
}

model TranslatorRequest {
  id                          String                  @id @default(cuid())
  requesterEmail              String?
  emailVerifiedAt             DateTime?
  verificationTokenHash       String?
  verificationTokenExpiresAt  DateTime?
  verificationEmailSentAt     DateTime?
  publishedNotificationSentAt DateTime?
  requestedName               String
  description                 String
  exampleInput                String?
  desiredStyle                String?
  suggestedCategory           String?
  audience                    String?
  notes                       String?
  adminNotes                  String?
  status                      TranslatorRequestStatus @default(PENDING_EMAIL_VERIFICATION)
  aiDraftJson                 Json?
  aiDraftGeneratedAt          DateTime?
  createdTranslatorId         String?
  createdTranslator           Translator?             @relation("RequestCreatedTranslator", fields: [createdTranslatorId], references: [id], onDelete: SetNull)
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([createdTranslatorId])
  @@index([verificationTokenHash])
  @@index([requesterEmail, status])
}

model TranslatorComment {
  id               String                  @id @default(cuid())
  translatorId     String
  name             String
  email            String
  content          String
  status           CommentModerationStatus @default(PENDING_REVIEW)
  moderationReason String?
  reviewedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  translator       Translator              @relation(fields: [translatorId], references: [id], onDelete: Cascade)

  @@index([translatorId, status, createdAt])
  @@index([status, createdAt])
}

model AdPlacement {
  id            String          @id @default(cuid())
  name          String
  key           String          @unique
  description   String?
  pageType      AdPageType      @default(ALL)
  deviceType    AdDeviceType    @default(ALL)
  placementType AdPlacementType @default(CUSTOM)
  providerType  AdProviderType  @default(ADSENSE)
  adSenseSlot   String?
  codeSnippet   String?
  categoryId    String?
  isActive      Boolean         @default(false)
  sortOrder     Int             @default(0)
  archivedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([pageType, deviceType, isActive, sortOrder])
  @@index([categoryId, isActive])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model GrowthSettings {
  id                              String          @id @default("global")
  enabled                         Boolean         @default(false)
  intensity                       GrowthIntensity @default(BALANCED)
  workerBatchSize                 Int             @default(5)
  ownedDomains                    String[]        @default(["saytwist.com", "www.saytwist.com", "translator.whattypeof.com"])
  attributionEnabled              Boolean         @default(false)
  attributionWindowDays           Int             @default(7)
  attributionSessionRetentionDays Int             @default(30)
  attributionEventRetentionDays   Int             @default(90)
  configVersion                   Int             @default(1)
  updatedById                     String?
  createdAt                       DateTime        @default(now())
  updatedAt                       DateTime        @updatedAt
  updatedBy                       User?           @relation("GrowthSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedAt])
}

model GrowthJob {
  id             String          @id @default(cuid())
  type           GrowthJobType
  status         GrowthJobStatus @default(PENDING)
  payload        Json?
  idempotencyKey String          @unique
  runAfter       DateTime        @default(now())
  attemptCount   Int             @default(0)
  maxAttempts    Int             @default(3)
  workerId       String?
  claimedAt      DateTime?
  leaseUntil     DateTime?
  heartbeatAt    DateTime?
  lastError      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  completedAt    DateTime?

  @@index([status, runAfter])
  @@index([leaseUntil])
  @@index([workerId, status])
}

model GrowthActivity {
  id             String                  @id @default(cuid())
  actorKind      GrowthActivityActorKind
  actorUserId    String?
  entityType     String
  entityId       String
  action         String
  fromState      String?
  toState        String?
  summary        Json?
  correlationKey String?
  createdAt      DateTime                @default(now())
  actorUser      User?                   @relation("GrowthActivityUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([correlationKey])
}

model GrowthWorkerHeartbeat {
  workerId     String             @id
  invocationId String
  status       GrowthWorkerStatus @default(IDLE)
  currentJobId String?
  buildVersion String?
  startedAt    DateTime           @default(now())
  heartbeatAt  DateTime           @default(now())
  completedAt  DateTime?
  lastError    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status, heartbeatAt])
}

model GrowthPinterestAccount {
  id                      String                              @id @default(cuid())
  pinterestAccountId      String                              @unique
  publicationRole         GrowthPinterestPublicationRole
  activeRole              GrowthPinterestPublicationRole?     @unique
  username                String
  businessName            String?
  profileImageUrl         String?
  websiteUrl              String?
  pinterestAccountType    String?
  apiEnvironment          GrowthPinterestApiEnvironment
  connectionStatus        GrowthPinterestConnectionStatus     @default(CONNECTED)
  grantedScopes           String[]
  encryptedCredentials    String?
  credentialVersion       Int                                 @default(1)
  accessTokenExpiresAt    DateTime?
  refreshTokenExpiresAt   DateTime?
  lastAccountSyncAt       DateTime?
  lastBoardSyncAt         DateTime?
  lastSuccessfulApiCallAt DateTime?
  lastConnectionError     String?
  disconnectedAt          DateTime?
  createdAt               DateTime                            @default(now())
  updatedAt               DateTime                            @updatedAt
  boards                  GrowthPinterestBoard[]
  pins                    GrowthPinterestPin[]
  dailyMetrics            GrowthPinterestAccountMetricDaily[]
  analyticsState          GrowthPinterestAnalyticsState?

  @@index([connectionStatus, publicationRole])
  @@index([apiEnvironment, connectionStatus])
}

model GrowthPinterestBoard {
  id               String                 @id @default(cuid())
  accountId        String
  pinterestBoardId String
  name             String
  description      String?
  privacy          String?
  ownerUsername    String?
  isActive         Boolean                @default(true)
  lastSeenAt       DateTime
  lastSyncedAt     DateTime
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  account          GrowthPinterestAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pins             GrowthPinterestPin[]

  @@unique([accountId, pinterestBoardId])
  @@index([accountId, isActive])
  @@index([pinterestBoardId])
}

model GrowthPinterestPin {
  id                     String                           @id @default(cuid())
  pinterestPinId         String                           @unique
  accountId              String
  boardId                String?
  pinterestBoardId       String?
  title                  String?
  description            String?
  destinationUrl         String?
  creativeType           String?
  mediaType              String?
  previewImageUrl        String?
  publishedAt            DateTime?
  isActive               Boolean                          @default(true)
  analyticsEligible      Boolean                          @default(false)
  lastSeenAt             DateTime
  lastSyncedAt           DateTime
  lastAnalyticsSyncAt    DateTime?
  analyticsPriorityAt    DateTime?
  summaryStartDate       DateTime?
  summaryEndDate         DateTime?
  summaryFetchedAt       DateTime?
  summaryImpressions     BigInt?
  summarySaves           BigInt?
  summaryPinClicks       BigInt?
  summaryOutboundClicks  BigInt?
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  account                GrowthPinterestAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  board                  GrowthPinterestBoard?            @relation(fields: [boardId], references: [id], onDelete: SetNull)
  dailyMetrics           GrowthPinterestPinMetricDaily[]
  attributionRefs        GrowthAttributionRef[]
  opportunityMemberships GrowthContentClusterMembership[]
  opportunitySignals     GrowthPinSignal[]

  @@index([accountId, isActive])
  @@index([accountId, isActive, analyticsEligible, lastAnalyticsSyncAt])
  @@index([accountId, lastAnalyticsSyncAt])
  @@index([accountId, analyticsPriorityAt])
  @@index([pinterestBoardId])
}

model GrowthAttributionRef {
  id                 String                            @id @default(cuid())
  publicRef          String                            @unique
  pinId              String?                           @unique
  destinationPath    String
  campaignKey        String
  contentKey         String
  modelVersion       String
  isActive           Boolean                           @default(true)
  revokedAt          DateTime?
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt
  pinterestPin       GrowthPinterestPin?               @relation(fields: [pinId], references: [id], onDelete: SetNull)
  firstTouchSessions GrowthAttributionSession[]        @relation("GrowthAttributionFirstRef")
  lastTouchSessions  GrowthAttributionSession[]        @relation("GrowthAttributionLastRef")
  qualifiedSessions  GrowthAttributionSession[]        @relation("GrowthAttributionQualifiedRef")
  events             GrowthAttributionEvent[]
  dailyAggregates    GrowthAttributionDailyAggregate[]

  @@index([isActive, createdAt])
  @@index([modelVersion, createdAt])
}

model GrowthAttributionSession {
  id                        String                   @id @default(cuid())
  tokenHash                 String                   @unique
  firstAttributionRefId     String
  lastAttributionRefId      String
  firstTouchAt              DateTime
  lastTouchAt               DateTime
  attributionExpiresAt      DateTime
  modelVersion              String
  qualifiedConversionAt     DateTime?
  qualifiedAttributionRefId String?
  qualifiedTranslationLogId String?                  @unique
  qualifiedTranslatorId     String?
  deleteAfter               DateTime
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  firstAttributionRef       GrowthAttributionRef     @relation("GrowthAttributionFirstRef", fields: [firstAttributionRefId], references: [id], onDelete: Restrict)
  lastAttributionRef        GrowthAttributionRef     @relation("GrowthAttributionLastRef", fields: [lastAttributionRefId], references: [id], onDelete: Restrict)
  qualifiedAttributionRef   GrowthAttributionRef?    @relation("GrowthAttributionQualifiedRef", fields: [qualifiedAttributionRefId], references: [id], onDelete: Restrict)
  qualifiedTranslationLog   TranslationLog?          @relation("GrowthAttributionQualifiedTranslation", fields: [qualifiedTranslationLogId], references: [id], onDelete: SetNull)
  qualifiedTranslator       Translator?              @relation("GrowthAttributionQualifiedTranslator", fields: [qualifiedTranslatorId], references: [id], onDelete: SetNull)
  events                    GrowthAttributionEvent[]

  @@index([attributionExpiresAt])
  @@index([deleteAfter])
  @@index([firstAttributionRefId, firstTouchAt])
  @@index([lastAttributionRefId, lastTouchAt])
  @@index([qualifiedAttributionRefId, qualifiedConversionAt])
}

model GrowthAttributionEvent {
  id                           String                     @id @default(cuid())
  sessionId                    String?
  attributionRefId             String
  type                         GrowthAttributionEventType
  eventKey                     String                     @unique
  occurredAt                   DateTime                   @default(now())
  translatorId                 String?
  translationLogId             String?                    @unique
  isPrimaryQualifiedConversion Boolean                    @default(false)
  modelVersion                 String
  retentionAt                  DateTime
  createdAt                    DateTime                   @default(now())
  session                      GrowthAttributionSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  attributionRef               GrowthAttributionRef       @relation(fields: [attributionRefId], references: [id], onDelete: Restrict)
  translator                   Translator?                @relation(fields: [translatorId], references: [id], onDelete: SetNull)
  translationLog               TranslationLog?            @relation(fields: [translationLogId], references: [id], onDelete: SetNull)

  @@index([type, occurredAt])
  @@index([attributionRefId, occurredAt])
  @@index([translatorId, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([retentionAt])
}

model GrowthAttributionDailyAggregate {
  id                     String               @id @default(cuid())
  dimensionKey           String               @unique
  metricDate             DateTime
  attributionRefId       String
  translatorId           String?
  modelVersion           String
  landingSessions        Int                  @default(0)
  attributedTranslations Int                  @default(0)
  qualifiedConversions   Int                  @default(0)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  attributionRef         GrowthAttributionRef @relation(fields: [attributionRefId], references: [id], onDelete: Restrict)
  translator             Translator?          @relation(fields: [translatorId], references: [id], onDelete: SetNull)

  @@index([metricDate])
  @@index([attributionRefId, metricDate])
  @@index([translatorId, metricDate])
  @@index([modelVersion, metricDate])
}

model GrowthAccountStrategyReview {
  id                      String                              @id @default(cuid())
  reviewMonth             DateTime
  evidenceWindowStart     DateTime
  evidenceWindowEnd       DateTime
  modelVersion            String
  recommendation          GrowthAccountStrategyRecommendation
  plannedAccountCount     Int
  connectedAccountCount   Int
  recommendedAccountCount Int
  confidence              Int
  evidenceQuality         GrowthStrategyEvidenceQuality
  evidence                Json
  reasonCodes             String[]
  recommendationSummary   String
  createdAt               DateTime                            @default(now())
  completedAt             DateTime                            @default(now())

  @@unique([reviewMonth, modelVersion])
  @@index([recommendation, reviewMonth])
  @@index([completedAt])
}

model GrowthOpportunityAnalysisRun {
  id                       String                           @id @default(cuid())
  analysisDate             DateTime
  evidenceWindowStart      DateTime
  evidenceWindowEnd        DateTime
  intelligenceModelVersion String
  scoringModelVersion      String
  clusteringModelVersion   String
  evidenceQuality          GrowthOpportunityEvidenceQuality
  pinsConsidered           Int
  pinCap                   Int
  capReached               Boolean                          @default(false)
  clustersProduced         Int
  opportunitiesProduced    Int
  attributionCollection    String
  reasonCodes              String[]
  summary                  String
  createdAt                DateTime                         @default(now())
  completedAt              DateTime                         @default(now())
  snapshots                GrowthContentClusterSnapshot[]
  opportunities            GrowthOpportunity[]
  pinSignals               GrowthPinSignal[]

  @@unique([analysisDate, intelligenceModelVersion])
  @@index([completedAt])
}

model GrowthContentCluster {
  id                String                          @id @default(cuid())
  clusterKey        String
  name              String
  clusteringVersion String
  targetRole        GrowthPinterestPublicationRole?
  status            GrowthContentClusterStatus      @default(ACTIVE)
  summary           String
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  snapshots         GrowthContentClusterSnapshot[]
  opportunities     GrowthOpportunity[]
  pinSignals        GrowthPinSignal[]

  @@unique([clusterKey, clusteringVersion])
  @@index([status, updatedAt])
}

model GrowthContentClusterSnapshot {
  id                        String                           @id @default(cuid())
  analysisRunId             String
  clusterId                 String
  pinCount                  Int
  distinctDestinationCount  Int
  activeWeekCount           Int
  impressions               BigInt
  saves                     BigInt
  pinClicks                 BigInt
  outboundClicks            BigInt
  qualifiedConversions      Int?
  topPinImpressionPercent   Int?
  topThreeImpressionPercent Int?
  topPinOutboundPercent     Int?
  topThreeOutboundPercent   Int?
  velocityPercent           Int?
  evidenceQuality           GrowthOpportunityEvidenceQuality
  reasonCodes               String[]
  createdAt                 DateTime                         @default(now())
  analysisRun               GrowthOpportunityAnalysisRun     @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  cluster                   GrowthContentCluster             @relation(fields: [clusterId], references: [id], onDelete: Restrict)
  memberships               GrowthContentClusterMembership[]

  @@unique([analysisRunId, clusterId])
  @@index([clusterId, createdAt])
}

model GrowthContentClusterMembership {
  id              String                       @id @default(cuid())
  snapshotId      String
  pinId           String?
  translatorId    String?
  pinterestPinId  String
  destinationPath String?
  matchTokens     String[]
  createdAt       DateTime                     @default(now())
  snapshot        GrowthContentClusterSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  pin             GrowthPinterestPin?          @relation(fields: [pinId], references: [id], onDelete: SetNull)
  translator      Translator?                  @relation(fields: [translatorId], references: [id], onDelete: SetNull)

  @@unique([snapshotId, pinterestPinId])
  @@index([pinId])
  @@index([translatorId])
}

model GrowthOpportunity {
  id                     String                            @id @default(cuid())
  analysisRunId          String
  clusterId              String?
  type                   GrowthOpportunityType
  status                 GrowthOpportunityStatus           @default(OPEN)
  score                  Int
  confidence             Int
  evidenceQuality        GrowthOpportunityEvidenceQuality
  scoringModelVersion    String
  clusteringModelVersion String
  targetRole             GrowthPinterestPublicationRole?
  targetDestinationKind  GrowthOpportunityDestinationKind?
  evidence               Json
  reasonCodes            String[]
  dedupeKey              String                            @unique
  createdAt              DateTime                          @default(now())
  closedAt               DateTime?
  analysisRun            GrowthOpportunityAnalysisRun      @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  cluster                GrowthContentCluster?             @relation(fields: [clusterId], references: [id], onDelete: SetNull)

  @@index([status, score, createdAt])
  @@index([type, createdAt])
}

model GrowthPinSignal {
  id              String                           @id @default(cuid())
  analysisRunId   String
  clusterId       String?
  pinId           String?
  pinterestPinId  String
  type            GrowthPinSignalType
  strength        GrowthSignalStrength
  confidence      Int
  evidenceQuality GrowthOpportunityEvidenceQuality
  evidence        Json
  reasonCodes     String[]
  dedupeKey       String                           @unique
  createdAt       DateTime                         @default(now())
  analysisRun     GrowthOpportunityAnalysisRun     @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  cluster         GrowthContentCluster?            @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  pin             GrowthPinterestPin?              @relation(fields: [pinId], references: [id], onDelete: SetNull)

  @@index([type, confidence, createdAt])
  @@index([analysisRunId, type])
  @@index([pinId])
}

model GrowthPinterestAccountMetricDaily {
  id             String                 @id @default(cuid())
  accountId      String
  metricDate     DateTime
  impressions    BigInt                 @default(0)
  saves          BigInt                 @default(0)
  pinClicks      BigInt                 @default(0)
  outboundClicks BigInt                 @default(0)
  engagements    BigInt                 @default(0)
  dataStatus     String
  fetchedAt      DateTime
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  account        GrowthPinterestAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, metricDate])
  @@index([metricDate])
  @@index([accountId, outboundClicks])
}

model GrowthPinterestPinMetricDaily {
  id             String             @id @default(cuid())
  pinId          String
  metricDate     DateTime
  impressions    BigInt             @default(0)
  saves          BigInt             @default(0)
  pinClicks      BigInt             @default(0)
  outboundClicks BigInt             @default(0)
  dataStatus     String
  fetchedAt      DateTime
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  pin            GrowthPinterestPin @relation(fields: [pinId], references: [id], onDelete: Cascade)

  @@unique([pinId, metricDate])
  @@index([metricDate])
  @@index([pinId, outboundClicks])
  @@index([outboundClicks, metricDate])
}

model GrowthPinterestAnalyticsState {
  id                         String                         @id @default(cuid())
  accountId                  String                         @unique
  status                     GrowthPinterestAnalyticsStatus @default(NEVER_SYNCED)
  inventoryBookmark          String?
  inventoryStartedAt         DateTime?
  inventoryPageCount         Int                            @default(0)
  inventoryPinCount          Int                            @default(0)
  inventorySeenBookmarks     String[]                       @default([])
  backfillStartDate          DateTime?
  backfillEndDate            DateTime?
  backfillStartedAt          DateTime?
  backfillCompletedAt        DateTime?
  backfillPinsTotal          Int                            @default(0)
  backfillPinsProcessed      Int                            @default(0)
  lastInventorySyncAt        DateTime?
  lastAccountAnalyticsSyncAt DateTime?
  lastPinAnalyticsSyncAt     DateTime?
  lastSuccessfulSyncAt       DateTime?
  lastAttemptAt              DateTime?
  lastError                  String?
  lastRateLimitLimit         String?
  lastRateLimitRemaining     String?
  lastRateLimitReset         String?
  rateLimitObservedAt        DateTime?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  account                    GrowthPinterestAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status, lastSuccessfulSyncAt])
}

model GrowthPinterestOAuthState {
  id              String                         @id @default(cuid())
  stateHash       String                         @unique
  adminUserId     String
  publicationRole GrowthPinterestPublicationRole
  apiEnvironment  GrowthPinterestApiEnvironment
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime                       @default(now())
  adminUser       User                           @relation("GrowthPinterestOAuthStateAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt, consumedAt])
  @@index([adminUserId, createdAt])
}

model IndexingLog {
  id           String           @id @default(cuid())
  translatorId String?
  url          String
  source       IndexingSource
  status       IndexingStatus   @default(PENDING)
  provider     IndexingProvider @default(GOOGLE_INDEXING_API)
  message      String?
  responseJson Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  translator   Translator?      @relation(fields: [translatorId], references: [id], onDelete: SetNull)

  @@index([translatorId, createdAt])
  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([provider, createdAt])
}
