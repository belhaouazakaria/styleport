  PINTEREST_ACCOUNT_SYNC
  PINTEREST_BOARD_SYNC
  PINTEREST_PIN_INVENTORY_SYNC
  PINTEREST_ACCOUNT_ANALYTICS_SYNC
  PINTEREST_PIN_ANALYTICS_SYNC
  ATTRIBUTION_RETENTION_CLEANUP
  ACCOUNT_STRATEGY_REVIEW
  OPPORTUNITY_INTELLIGENCE_ANALYSIS
  TRANSLATOR_AUTOPILOT_DECIDE
  TRANSLATOR_AUTOPILOT_EXECUTE
  IDEA_AUTOPILOT_DECIDE
  IDEA_AUTOPILOT_EXECUTE
  CREATIVE_LAB_GENERATE
}

enum GrowthCreativeDestinationKind {
  TRANSLATOR
  IDEA
}

enum GrowthCreativeArchetype {
  V1_CONTROL
  TYPOGRAPHY_LED
  EDITORIAL_LIST
  CONVERSATION_CHAT
