enum GrowthJobStatus {
  PENDING
  CLAIMED
  RUNNING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_TERMINAL
  CANCELLED
}

enum GrowthActivityActorKind {
  SYSTEM
  USER
  WORKER
}

enum GrowthWorkerStatus {
  RUNNING
  IDLE
  FAILED
}

enum GrowthPinterestPublicationRole {
  SAYTWIST
  SAYTWIST_IDEAS
  SAYTWIST_PLAYGROUND
}

enum GrowthPinterestConnectionStatus {
  CONNECTED
  DEGRADED
  REAUTH_REQUIRED
  DISCONNECTED
}

